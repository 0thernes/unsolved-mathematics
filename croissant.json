{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": { "@id": "cr:data", "@type": "@json" },
    "dataType": { "@id": "cr:dataType", "@type": "@vocab" },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "jsonPath": "cr:jsonPath",
    "recordSet": "cr:recordSet",
    "sc": "https://schema.org/",
    "source": "cr:source"
  },
  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "The Unsolved Mathematics Atlas",
  "version": "0.9.0",
  "datePublished": "2026-11-27",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/0thernes/unsolved-mathematics",
  "citeAs": "Donahue, Alexander S. (2026). The Unsolved Mathematics Atlas (v0.9.0). https://github.com/0thernes/unsolved-mathematics",
  "creator": [
    {
      "@type": "Person",
      "name": "Alexander S. Donahue",
      "sameAs": "https://orcid.org/0009-0006-8168-9648"
    }
  ],
  "description": "Audited, ranked dataset of 120 unsolved mathematical problems across 38 fields paired with 3,985 deterministic RAG text chunks (822,839 tokens), live arXiv/Crossref/DataCite citation and retraction audit logs (537 verified / 287 DOIs audited, 0 retracted, exact 1-to-1 bijection), a daily full metadata mirror of all 26 Left to Solve research programs (62,790 targets), dual RFC 3161 + Bitcoin OpenTimestamps manifest proofs, a 6-kernel Lean 4.35.0 formal core (69 headline theorems / 109 audited declarations across 8 domains), a catalytic C17/BMI2 + safe Rust Collatz accelerator, and a compiled AMS-LaTeX white paper.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "problems-json",
      "name": "data/problems.json",
      "contentUrl": "data/problems.json",
      "encodingFormat": "application/json",
      "description": "Ranked canonical registry of 120 mathematical problems with deterministic Composite Severity Scores."
    },
    {
      "@type": "cr:FileObject",
      "@id": "rag-corpus-jsonl",
      "name": "rag/corpus.jsonl",
      "contentUrl": "rag/corpus.jsonl",
      "encodingFormat": "application/x-ndjson",
      "description": "3,985 globally uniquely indexed text chunks (822,839 tokens) across all 120 seven-section mathematical dossiers."
    },
    {
      "@type": "cr:FileObject",
      "@id": "citation-log-json",
      "name": "data/citation-verification-log.json",
      "contentUrl": "data/citation-verification-log.json",
      "encodingFormat": "application/json",
      "description": "Primary-source API verification log across 646 identifier-bearing bibliography rows (537 verified, exact 1-to-1 bijection)."
    },
    {
      "@type": "cr:FileObject",
      "@id": "retraction-audit-json",
      "name": "data/retraction-audit.json",
      "contentUrl": "data/retraction-audit.json",
      "encodingFormat": "application/json",
      "description": "Crossref and DataCite retraction/erratum audit log across all 287 verified DOIs (0 retracted)."
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "problems",
      "name": "problems",
      "description": "120 ranked mathematical problems with metadata, status, and Composite Severity Score.",
      "field": [
        { "@type": "cr:Field", "@id": "problems/rank", "name": "rank", "dataType": "sc:Integer", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].rank" } } },
        { "@type": "cr:Field", "@id": "problems/slug", "name": "slug", "dataType": "sc:Text", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].slug" } } },
        { "@type": "cr:Field", "@id": "problems/title", "name": "title", "dataType": "sc:Text", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].title" } } },
        { "@type": "cr:Field", "@id": "problems/field", "name": "field", "dataType": "sc:Text", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].field" } } },
        { "@type": "cr:Field", "@id": "problems/year_posed", "name": "year_posed", "dataType": "sc:Integer", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].year_posed" } } },
        { "@type": "cr:Field", "@id": "problems/status", "name": "status", "dataType": "sc:Text", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].status" } } },
        { "@type": "cr:Field", "@id": "problems/css", "name": "css", "dataType": "sc:Float", "source": { "fileObject": { "@id": "problems-json" }, "extract": { "jsonPath": "$.problems[*].css" } } }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "rag_chunks",
      "name": "rag_chunks",
      "description": "3,985 deterministic RAG text chunks with unique IDs and token counts.",
      "field": [
        { "@type": "cr:Field", "@id": "rag_chunks/id", "name": "id", "dataType": "sc:Text", "source": { "fileObject": { "@id": "rag-corpus-jsonl" }, "extract": { "column": "id" } } },
        { "@type": "cr:Field", "@id": "rag_chunks/slug", "name": "slug", "dataType": "sc:Text", "source": { "fileObject": { "@id": "rag-corpus-jsonl" }, "extract": { "column": "slug" } } },
        { "@type": "cr:Field", "@id": "rag_chunks/section", "name": "section", "dataType": "sc:Text", "source": { "fileObject": { "@id": "rag-corpus-jsonl" }, "extract": { "column": "section" } } },
        { "@type": "cr:Field", "@id": "rag_chunks/text", "name": "text", "dataType": "sc:Text", "source": { "fileObject": { "@id": "rag-corpus-jsonl" }, "extract": { "column": "text" } } },
        { "@type": "cr:Field", "@id": "rag_chunks/tokens", "name": "tokens", "dataType": "sc:Integer", "source": { "fileObject": { "@id": "rag-corpus-jsonl" }, "extract": { "column": "tokens" } } }
      ]
    }
  ]
}
