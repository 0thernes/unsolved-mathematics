# Environment variables for The Unsolved Mathematics Atlas
# Copy to .env only if overriding defaults; no secrets are required.

# Optional Python interpreter override for Makefile / justfile
PY=python

# Optional polite contact email for Crossref / arXiv citation verification User-Agent
ATLAS_CONTACT_EMAIL=0_0@0thernes.art

# Optional path to bubblewrap sandbox binary for `lake check` / `lake comparator` (Linux)
COMPARATOR_BWRAP=bwrap

# Optional sentence-transformers model for dense RAG indexing (`rag/embed_index.py`)
ATLAS_EMBED_MODEL=all-MiniLM-L6-v2
